# Backend runtime configuration (copy to .env for local overrides)
PORT=5000

# MongoDB — replica set is required for transactional flows
MONGO_URI=mongodb://localhost:27017/spicehub_dev

# Redis (optional in development; the API degrades gracefully without it)
REDIS_URI=redis://localhost:6379

# JWT signing secret — MUST be replaced with a strong random value in production
JWT_SECRET=change-me-to-a-long-random-secret

# Local demo convenience: allows the frontends to call terminal/admin APIs without a JWT.
# Leave unset/false in production — startup rejects it when NODE_ENV=production.
DEV_AUTH_BYPASS=true

# Manager approval PIN used for rate overrides / void authorisations.
# Production rejects missing, non-numeric, common/default PINs.
MANAGER_SECURITY_PIN=847291

# Public URL of the guest room portal. Used when provisioning printable room QR codes.
GUEST_PORTAL_URL=http://localhost:3004

# Payment gateway placeholders
MERCHANT_VPA=spicehub@upi
MERCHANT_NAME=SpiceHub
SOUNDBOX_WEBHOOK_SECRET=change-me
