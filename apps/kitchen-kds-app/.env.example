# Backend origin. Leave empty for same-origin deployments (recommended).
# Local development automatically falls back to http://localhost:5000.
# For a split deployment use e.g. https://api.spicehub.example
VITE_API_BASE_URL=

# Optional Socket.IO origin override. Empty uses the same origin as the API.
VITE_SOCKET_URL=
VITE_API_TIMEOUT_MS=15000

# Tenant defaults. The live demo context / signed staff session normally wins.
VITE_HOTEL_ID=
VITE_HOTEL_NAME=SpiceHub Heritage Palace

VITE_ENABLE_PWA=false
VITE_ENABLE_DEBUG_LOGS=false

# Sibling portal origins. Local dev defaults to http://localhost:3001-3008.
# Deployed builds fall back to the current origin instead of localhost.
VITE_PORTAL_ADMIN_URL=
VITE_PORTAL_CASHIER_URL=
VITE_PORTAL_RECEPTION_URL=
VITE_PORTAL_KDS_URL=
VITE_PORTAL_WAITER_URL=
VITE_PORTAL_CUSTOMER_URL=
VITE_PORTAL_GUEST_URL=
VITE_PORTAL_SUPERADMIN_URL=
