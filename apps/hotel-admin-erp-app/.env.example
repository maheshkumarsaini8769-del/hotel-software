# Hotel Admin ERP production configuration
#
# Backend origin. Leave empty when the admin app and /api/v1 are served from
# the same origin (the recommended production setup). For a split deployment,
# set the public backend origin, e.g. https://api.spicehub.example
VITE_API_BASE_URL=

# Sibling portal origins used by "open portal" links and staff terminal links.
# In local development these default to http://localhost:3001-3008.
# Set every value in production; deployed builds fall back to the current
# origin instead of localhost when a value is omitted.
VITE_PORTAL_CUSTOMER_URL=
VITE_PORTAL_WAITER_URL=
VITE_PORTAL_KDS_URL=
VITE_PORTAL_GUEST_URL=
VITE_PORTAL_ADMIN_URL=
VITE_PORTAL_CASHIER_URL=
VITE_PORTAL_RECEPTION_URL=
VITE_PORTAL_SUPERADMIN_URL=
