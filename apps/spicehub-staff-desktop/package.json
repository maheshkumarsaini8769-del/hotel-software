{
  "name": "spicehub-staff-desktop",
  "version": "1.0.0",
  "description": "SpiceHub Hospitality Staff Workstation Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.spicehub.staffdesktop",
    "productName": "SpiceHub-Staff",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "SpiceHub-Staff-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
