{
  "name": "@spicehub/shared-types",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').renameSync('dist/esm/index.js','dist/esm/index.mjs')\""
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
