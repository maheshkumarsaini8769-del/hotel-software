{
  "name": "spicehub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SpiceHub Enterprise Multi-Tenant SaaS Hospitality ERP",
  "workspaces": [
    "backend",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "dev:customer": "npm run dev --workspace=@spicehub/customer-table-app",
    "dev:waiter": "npm run dev --workspace=@spicehub/waiter-mobile-app",
    "dev:kds": "npm run dev --workspace=@spicehub/kitchen-kds-app",
    "dev:guest": "npm run dev --workspace=@spicehub/guest-room-portal-app",
    "dev:admin": "npm run dev --workspace=@spicehub/hotel-admin-erp-app",
    "dev:cashier": "npm run dev --workspace=@spicehub/cashier-pos-app",
    "dev:reception": "npm run dev --workspace=@spicehub/reception-frontdesk-app",
    "dev:superadmin": "npm run dev --workspace=@spicehub/superadmin-saas-app",
    "build:backend": "npm run build:shared-types && npm run build --workspace=backend",
    "build:all": "npm run build:shared-types && npm run build --workspaces --if-present",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "test:backend": "npm run test --workspace=backend",
    "test:luxury": "tsx scripts/verify_luxury_e2e.ts",
    "test:browser": "tsx scripts/browser_full_e2e_audit.ts",
    "verify:emulator": "tsx scripts/verify_all_websites_emulator.ts",
    "test:shift53": "tsx scripts/test_shift53_bom_browser.ts",
    "integrity:check": "tsx scripts/monorepo_health_gate.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "build:shared-types": "npm run build --workspace=@spicehub/shared-types"
  },
  "keywords": [
    "spicehub",
    "hospitality",
    "hotel-pms",
    "restaurant-pos",
    "kds",
    "multi-tenant"
  ],
  "author": "SpiceHub Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer": "^25.15.0",
    "vite": "^5.4.21"
  }
}
